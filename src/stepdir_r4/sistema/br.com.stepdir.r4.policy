<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  Política polkit do helper de drivers da StepDir R4.

  Instalada pelo pacote .deb (F5) em /usr/share/polkit-1/actions/, com o
  helper em /usr/libexec/stepdir-r4/ (ajustar o annotate abaixo se o
  caminho mudar no empacotamento). Rodando do código-fonte (F3), o pkexec
  funciona sem esta política, com o prompt genérico do polkit.
-->
<policyconfig>
  <vendor>StepDir R4</vendor>

  <action id="br.com.stepdir.r4.instalar-drivers">
    <description>Install StepDir R4 drivers</description>
    <description xml:lang="pt_BR">Instalar os drivers da placa StepDir R4</description>
    <message>Authentication is required to install the StepDir R4 drivers</message>
    <message xml:lang="pt_BR">É necessária a senha de administrador para instalar os drivers da StepDir R4 em /usr/lib/linuxcnc/modules (com backup dos originais)</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/stepdir-r4/helper_drivers.py</annotate>
  </action>
</policyconfig>
