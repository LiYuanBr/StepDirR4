<labelframe text="Spindle Speed:">
<font>("Helvetica",10)</font>

  <vbox>
               
                <bar>
                        <halpin>"spindle-speed"</halpin>
                        <max_>24000</max_>
                </bar>
              
                <hbox>
                    <led>
                        <halpin>"spindle-at-speed-led"</halpin> 
                        <size>20</size> 
                        <on_color>"green"</on_color>
                        <off_color>"red"</off_color>
                    </led>
                    
                    <label>
                        <text>"Spindle ON"</text>
                        <font>("Helvetica",10)</font>
                   </label>
                   
                   <label>
						<text>""</text>                 <!-- Texto do Label -->
						<font>("Helvetica", 2) </font>  <!-- Fonte e tamanho -->
                   </label>
                   
						<button>
							<halpin>"m3-button"</halpin>
							<text>"Ligar Spindle"</text>
							<pady>3</pady>
							<padx>19</padx>
							<bd>3</bd>
						</button>
                </hbox>
                
        </vbox>

